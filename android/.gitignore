/local.properties
GeneratedPluginRegistrant.java
.cxx/

# Remember to never publicly share your RELEASE keystore.
# See https://flutter.dev/to/reference-keystore
key.properties
**/*.keystore
**/*.jks

# Exception on purpose: the *debug* key is shared by the whole team (and its
# SHA-1 is registered in Firebase for Google Sign-In). It is not a release key:
# the alias/password are the Android debug defaults, published in the Android docs.
!app/debug.keystore
